{
  "name": "foundry",
  "type": "commonjs",
  "version": "0.0.0",
  "description": "An AI-native local personal workbench",
  "main": "./out/main/index.js",
  "author": {
    "name": "tinywaves",
    "email": "dhzhme@gmail.com"
  },
  "keywords": [
    "agent",
    "ai"
  ],
  "homepage": "https://github.com/tinywaves/foundry",
  "repository": {
    "url": "git+https://github.com/tinywaves/foundry.git",
    "type": "git"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "pnpm run typecheck && electron-vite build",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "start": "electron-vite preview",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@astryxdesign/cli": "^0.7.0",
    "@astryxdesign/core": "^0.7.0",
    "@astryxdesign/theme-neutral": "^0.7.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/poppins": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.104.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "firecrawl": "^4.50.0",
    "i18next": "^26.5.3",
    "openai": "^7.37.0",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@dhzh/eslint-config": "^3.1.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
