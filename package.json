{
  "name": "@dhzh/foundry",
  "type": "module",
  "version": "3.0.1",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    }
  },
  "description": "An AI-native local personal workbench",
  "author": {
    "name": "tinywaves",
    "email": "dhzhme@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/tinywaves/foundry",
  "keywords": [
    "agent",
    "ai"
  ],
  "bin": {
    "foundry": "./dist/index.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "url": "git+https://github.com/tinywaves/foundry.git",
    "type": "git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:web",
    "build:cli": "tsdown",
    "build:web": "pnpm --filter web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:api": "tsx watch --clear-screen=false src/server/dev.ts",
    "dev:web": "pnpm --filter web dev",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "prepack": "pnpm build",
    "prepare": "prek install --hook-type pre-commit --hook-type commit-msg",
    "release": "bumpp",
    "release:publish": "pnpm release && pnpm publish --access public",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:dev": "vitest",
    "version:update": "taze major",
    "version:update:w": "taze major -w"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dhzh/eslint-config": "^3.1.3",
    "@j178/prek": "^0.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "taze": "^21.3.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "citty": "^0.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
