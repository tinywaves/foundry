      "checkConstraints": {
        "providers_id_not_empty": {
          "name": "providers_id_not_empty",
          "value": "length(\"providers\".\"id\") > 0"
        },
        "providers_runtime_valid": {
          "name": "providers_runtime_valid",
          "value": "\"providers\".\"runtime\" IN ('codex', 'claude-code')"
        },
        "providers_name_valid": {
          "name": "providers_name_valid",
          "value": "length(trim(\"providers\".\"name\")) BETWEEN 1 AND 100"
        },
        "providers_official_website_valid": {
          "name": "providers_official_website_valid",
          "value": "\"providers\".\"official_website\" IS NULL OR length(\"providers\".\"official_website\") <= 2048"
        },
        "providers_remark_valid": {
          "name": "providers_remark_valid",
          "value": "\"providers\".\"remark\" IS NULL OR length(\"providers\".\"remark\") <= 2000"
        },
        "providers_avatar_valid": {
          "name": "providers_avatar_valid",
          "value": "(\"providers\".\"avatar_mime_type\" IS NULL AND \"providers\".\"avatar_data\" IS NULL) OR (\"providers\".\"avatar_mime_type\" IN ('image/png', 'image/jpeg', 'image/webp', 'image/svg+xml') AND \"providers\".\"avatar_data\" IS NOT NULL AND length(\"providers\".\"avatar_data\") BETWEEN 1 AND 2097152)"
        },
        "providers_configuration_json": {
          "name": "providers_configuration_json",
          "value": "json_valid(\"providers\".\"configuration\")"
        },
        "providers_created_at_nonnegative": {
          "name": "providers_created_at_nonnegative",
          "value": "\"providers\".\"created_at\" >= 0"
        },
        "providers_updated_at_valid": {
          "name": "providers_updated_at_valid",
          "value": "\"providers\".\"updated_at\" >= \"providers\".\"created_at\""
        },
        "providers_deleted_at_valid": {
          "name": "providers_deleted_at_valid",
          "value": "\"providers\".\"deleted_at\" IS NULL OR \"providers\".\"deleted_at\" >= \"providers\".\"created_at\""
        }
      }
